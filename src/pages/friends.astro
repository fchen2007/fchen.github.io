---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { friendLinks } from "../data/friends";
---

<MainGridLayout title="友链" description="我的朋友们和值得访问的网站">
	<div class="card-base px-5 py-7 md:px-9 md:py-9">
		<header class="mb-7">
			<div class="flex items-center gap-3">
				<Icon
					name="material-symbols:link-rounded"
					class="text-[2rem] text-[var(--primary)]"
				/>
				<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
					友链
				</h1>
			</div>
			
		</header>

		{
			friendLinks.length > 0 ? (
				<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
					{friendLinks.map((friend) => (
						<a
							href={friend.url}
							target="_blank"
							rel="noopener noreferrer"
							class="group relative flex items-center gap-4 rounded-2xl border border-black/[0.08] bg-black/[0.025] p-4 transition duration-300 hover:-translate-y-1 hover:border-[var(--primary)] hover:shadow-lg dark:border-white/10 dark:bg-white/[0.035]"
						>
							{friend.avatar ? (
								<img
									src={friend.avatar}
									alt={`${friend.name} 头像`}
									width="64"
									height="64"
									loading="lazy"
									class="h-16 w-16 shrink-0 rounded-2xl object-cover bg-black/5 dark:bg-white/10"
								/>
							) : (
								<div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-[var(--primary)] text-2xl font-bold text-white">
									{friend.name.slice(0, 1)}
								</div>
							)}

							<div class="min-w-0 flex-1">
								<div class="flex items-center gap-2">
									<h2 class="truncate text-lg font-bold text-neutral-900 transition group-hover:text-[var(--primary)] dark:text-neutral-100">
										{friend.name}
									</h2>
									<Icon
										name="fa6-solid:arrow-up-right-from-square"
										class="shrink-0 text-xs text-black/25 transition group-hover:text-[var(--primary)] dark:text-white/25"
									/>
								</div>
								<p class="mt-1 line-clamp-2 text-sm leading-6 text-neutral-500 dark:text-neutral-400">
									{friend.description || "欢迎访问"}
								</p>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="rounded-2xl border border-dashed border-black/15 px-6 py-14 text-center text-neutral-400 dark:border-white/15">
					友链正在整理中。
				</div>
			)
		}

	</div>
</MainGridLayout>
